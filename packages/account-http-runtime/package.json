{
  "name": "@samurai-sushi/account-http-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "browser": "./src/browser-rejected.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "browser": "./src/browser-rejected.ts",
      "default": "./src/next.ts"
    },
    "./server": {
      "browser": "./src/browser-rejected.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "test": "vitest run --root ../.. packages/account-http-runtime/src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@samurai-sushi/account-proof-verifier": "workspace:*",
    "@samurai-sushi/persistence": "workspace:*",
    "next": "16.2.12",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@samurai-sushi/domain": "workspace:*",
    "@taquito/utils": "25.0.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5"
  }
}
