{
  "name": "@samurai-sushi/receipt-authority",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./deployment-manifest": "./src/deployment-manifest.ts",
